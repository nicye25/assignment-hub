# Canvas (CourseWorks) via API token; wins over the ICS feed when set
CANVAS_API_TOKEN=
CANVAS_BASE_URL=https://courseworks2.columbia.edu
# Comma-separated course ids to skip, if one course returns a permission error
CANVAS_EXCLUDE_COURSES=

# Canvas via calendar feed (used only when CANVAS_API_TOKEN is not set)
CANVAS_ICS_URL=

GRADESCOPE_EMAIL=
GRADESCOPE_PASSWORD=
# Optional override of the guessed term, e.g. "Fall 2026"
GRADESCOPE_TERMS=